# Server
PORT=5000
# IMPORTANT: set to "production" on any deployed instance — leaving this unset
# causes the password-reset URL to be returned in the API response (dev-only behaviour).
NODE_ENV=production

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/invoice-automation

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS — must match the frontend dev server / deployed origin
FRONTEND_URL=http://localhost:5173

# Python ML microservice (FastAPI). Must be running before the backend if you
# want ML extraction/matching/anomaly scoring; the backend falls back to its
# built-in regex/substring logic when this is unreachable.
ML_SERVICE_URL=http://localhost:8000

# ── Job queue (BullMQ + Redis) ────────────────────────────────────────────────
# OCR + matching are offloaded to a background worker so uploads return instantly
# and the system can absorb large bursts. ALL OPTIONAL: if Redis is unreachable
# the backend falls back to processing inline (the original synchronous behaviour),
# so local dev works with nothing extra installed.
#
# QUEUE_ENABLED      set to "false" to force inline processing even if Redis is up
# REDIS_URL          Redis connection string for the queue broker
# RUN_WORKER_INLINE  "true" runs the worker inside the API process (handy for
#                    single-machine dev). For scale, run `npm run worker` as one
#                    or more separate processes instead and leave this unset.
# WORKER_CONCURRENCY how many jobs one worker handles at once (default 5)
# QUEUE_JOB_ATTEMPTS retries per job before it's marked failed (default 3)
# MONGO_POOL_SIZE    max concurrent MongoDB connections per process (default 100)
QUEUE_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
RUN_WORKER_INLINE=false
WORKER_CONCURRENCY=5
QUEUE_JOB_ATTEMPTS=3
MONGO_POOL_SIZE=100

# ── Rate limiting ─────────────────────────────────────────────────────────────
# RATE_LIMIT_UPLOAD  max invoice uploads per IP per minute (default 10)
# RATE_LIMIT_API     max general API requests per IP per minute (default 200)
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_API=200

# ── File storage ──────────────────────────────────────────────────────────────
# Leave STORAGE_BACKEND=local unless you are running workers on a DIFFERENT
# machine than the API. On a single machine, local disk is simpler and faster.
#
# Why MinIO exists: when the API and BullMQ workers run on separate hosts, a
# worker on Machine B cannot read a file the API saved to Machine A's local
# disk. STORAGE_BACKEND=minio points all processes at a shared bucket so every
# host can access every file. See deploy/README.md for a full explanation.
#
# STORAGE_BACKEND   "local" = files on disk under backend/uploads/ (default)
#                   "minio" = files in a shared MinIO bucket (multi-machine only)
#                   Falls back to "local" automatically if MinIO is unreachable.
# The MINIO_* vars and the "minio" npm package are only used when set to "minio".
STORAGE_BACKEND=local
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=invoices
MINIO_REGION=us-east-1
