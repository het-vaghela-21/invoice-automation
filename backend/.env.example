# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/invoice-automation

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS — must match the frontend dev server / deployed origin
FRONTEND_URL=http://localhost:5173

# Python ML microservice (FastAPI). Must be running before the backend if you
# want ML extraction/matching/anomaly scoring; the backend falls back to its
# built-in regex/substring logic when this is unreachable.
ML_SERVICE_URL=http://localhost:8000

# ── Job queue (BullMQ + Redis) ────────────────────────────────────────────────
# OCR + matching are offloaded to a background worker so uploads return instantly
# and the system can absorb large bursts. ALL OPTIONAL: if Redis is unreachable
# the backend falls back to processing inline (the original synchronous behaviour),
# so local dev works with nothing extra installed.
#
# QUEUE_ENABLED      set to "false" to force inline processing even if Redis is up
# REDIS_URL          Redis connection string for the queue broker
# RUN_WORKER_INLINE  "true" runs the worker inside the API process (handy for
#                    single-machine dev). For scale, run `npm run worker` as one
#                    or more separate processes instead and leave this unset.
# WORKER_CONCURRENCY how many jobs one worker handles at once (default 5)
# QUEUE_JOB_ATTEMPTS retries per job before it's marked failed (default 3)
# MONGO_POOL_SIZE    max concurrent MongoDB connections per process (default 100)
QUEUE_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
RUN_WORKER_INLINE=false
WORKER_CONCURRENCY=5
QUEUE_JOB_ATTEMPTS=3
MONGO_POOL_SIZE=100
